# ─── Seguridad ─────────────────────────────────────────────
# Contraseña del panel admin (cámbiala por algo fuerte)
ADMIN_PASS=clubipico123
# Secreto para firmar el token de sesión del admin (cadena larga aleatoria)
TOKEN_SECRET=genera-una-cadena-larga-y-aleatoria-aqui

# ─── CORS / Frontend ───────────────────────────────────────
# La URL de tu sitio en Vercel (sin / al final)
FRONTEND_URL=https://tu-sitio.vercel.app

# ─── Telegram (notificaciones al admin) ────────────────────
# Token del bot creado con @BotFather
TELEGRAM_BOT_TOKEN=
# ID(s) de chat separados por coma (obtén el tuyo con @userinfobot)
TELEGRAM_CHAT_ID=

# ─── Correo (Resend — recordatorios a clientes) ────────────
# API key de https://resend.com (gratuito)
RESEND_API_KEY=
# Remitente: con cuenta gratuita usa onboarding@resend.dev o tu dominio verificado
MAIL_FROM="Club Hípico <onboarding@resend.dev>"

# ─── General ───────────────────────────────────────────────
TZ_NAME=America/Mexico_City
# Recordatorio al cliente X horas antes de su clase (default 24)
REMINDER_HOURS_BEFORE=24
